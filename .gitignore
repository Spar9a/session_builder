# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

**/builds
**/.terraform

docker_mount/*

**/__pycache__
.venv

# Crash log files
crash.log
crash.*.log


# Ignore override files as they are usually used for local dev overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files
.terraform.lock.hcl

# Ignore Mac OS specific files
.DS_Store

# Ignore local environment files
.env
.envrc

# Ignore any local backup files
*.backup
*.bak
*.swp

# Ignore any log files
*.log

# Ignore any local development files
.idea/
.vscode/